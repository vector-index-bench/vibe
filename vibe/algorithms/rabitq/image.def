Bootstrap: localimage
From: base.sif

%post
  git clone --depth 1 --branch v0.3.7 https://github.com/VectorDB-NTU/RaBitQ-Library.git /RaBitQ-Library

  cd /RaBitQ-Library || exit 1
  git config --global --add safe.directory /RaBitQ-Library

  micromamba install -y -q -c conda-forge -c pytorch python=3.12 faiss-cpu=1.14.3
  micromamba clean --all --yes

  pip install --no-cache-dir scikit-build-core
  pip install --no-cache-dir --no-build-isolation --no-deps .
