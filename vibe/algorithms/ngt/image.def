Bootstrap: localimage
From: base.sif

%post
  apt install -y --no-install-recommends libblas-dev liblapack-dev
  pip install --no-cache-dir meson ninja

  git clone https://github.com/intel/x86-simd-sort.git
  git config --global --add safe.directory /x86-simd-sort

  cd x86-simd-sort
  git fetch --tags
  git checkout v7.0
  meson setup build -Dbuildtype=release
  ninja -C build
  meson install -C build
  cd ..

  git clone -b main https://github.com/NGT-labs/ngt.git

  cd ngt
  mkdir build
  cd build
  cmake -DNGTQG_NO_ROTATION=ON -DNGTQG_ZERO_GLOBAL=ON -DNGTQG_X86SIMDSORT=ON -DNGT_DISABLE_NORMALIZATION_ERROR_CHECK=ON ..
  make -j 4 && make install
  cd ..

  ldconfig

  cd python
  python3 setup.py bdist_wheel
  pip install --no-cache-dir dist/ngt-*-linux_x86_64.whl
