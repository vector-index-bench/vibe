Bootstrap: localimage
From: base.sif

%post
  export DEBIAN_FRONTEND=noninteractive
  apt-get update
  apt-get install -y ca-certificates clang-18 cmake make python3-dev wget

  wget -O /tmp/fftw-3.3.10.tar.gz https://www.fftw.org/fftw-3.3.10.tar.gz
  tar -xzf /tmp/fftw-3.3.10.tar.gz -C /tmp
  cd /tmp/fftw-3.3.10
  ./configure --prefix=/usr/local --enable-float --enable-shared
  make -j$(nproc)
  make install
  ldconfig

  git clone https://github.com/cwida/PDX /opt/pdx
  cd /opt/pdx
  git config --global --add safe.directory /opt/pdx
  git reset --hard ffe79a5ddf454e3c7e4fa3861edfa7df596959c5

  export CC=/usr/bin/clang-18
  export CXX=/usr/bin/clang++-18
  export CMAKE_PREFIX_PATH=/usr/local:$CMAKE_PREFIX_PATH
  pip install --no-cache-dir .
